__pycache__/
*.pyc
.venv/
data/*.bin
data/*.txt
# data_add/ is generated by prepare_addition.py; track the tiny meta.pkl
# (the bench needs it to decode), ignore the regenerable binary shards.
data_add/*.bin

# out/ is ignored by default, but specific plot/log paths are re-included
# below so README image links + reproducible artefacts stay in git.
out/*
!out/compare.png
!out/compare_overfit.png
!out/compare_harvest.png
!out/smoke/
!out/tiny/
!out/tiny_clean/
!out/tiny_muon/
!out/tiny_mtp/
!out/small/
out/smoke/*
out/tiny/*
out/tiny_clean/*
out/tiny_muon/*
out/tiny_mtp/*
out/small/*
!out/smoke/train.log
!out/smoke/loss.png
!out/smoke/loss.svg
!out/tiny/train.log
!out/tiny/loss.png
!out/tiny/loss.svg
!out/tiny_clean/train.log
!out/tiny_clean/loss.png
!out/tiny_clean/loss.svg
!out/tiny_muon/train.log
!out/tiny_muon/loss.png
!out/tiny_muon/loss.svg
!out/tiny_mtp/train.log
!out/tiny_mtp/loss.png
!out/tiny_mtp/loss.svg
!out/small/train.log
!out/small/loss.png
!out/small/loss.svg

# Transient run/console logs (canonical metrics live under out/<run>/)
logs/
