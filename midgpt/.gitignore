__pycache__/
*.pyc
.venv/
data/*/
wandb/

# out/ is ignored by default; re-include specific run artifacts so the
# README image links + reproducible logs stay in git.
out/*
!out/smoke_124m/
out/smoke_124m/*
!out/smoke_124m/loss.png
!out/smoke_124m_train.log
!out/gpt2_350m_fweb_5060ti/
out/gpt2_350m_fweb_5060ti/*
!out/gpt2_350m_fweb_5060ti/loss.png
!out/gpt2_350m_fweb_5060ti/log.jsonl
!out/gpt2_350m_fweb_5060ti_train.log
# fused-CE showcase (exact loss, -20% VRAM / -26% throughput on sm_120)
!out/gpt2_350m_fweb_5060ti_fusedce/
out/gpt2_350m_fweb_5060ti_fusedce/*
!out/gpt2_350m_fweb_5060ti_fusedce/compare_fusedce.png
!out/gpt2_350m_fweb_5060ti_fusedce/log.jsonl
!out/gpt2_350m_fweb_5060ti_fusedce_train.log
